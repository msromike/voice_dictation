{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | tr -d '\\r' | { read -r f; rc=0; case \"$f\" in *.py) /c/bin/repos/voice_dictation/venv/Scripts/ruff.exe check --ignore C901,PLR09,RUF100 \"$f\" 1>&2 || rc=2; /c/bin/repos/voice_dictation/venv/Scripts/python.exe /c/bin/repos/voice_dictation/tools/check_docstrings.py \"$f\" 1>&2 || rc=2;; esac; exit $rc; }",
            "timeout": 30,
            "statusMessage": "ruff (complexity deferred to commit) + docstrings"
          }
        ]
      }
    ]
  }
}
