# Everything else is tracked: aorus and the laptop sync through the private
# GitHub repo. Going public needs a fresh repo -- see pre-push.txt P6.

# Python Cache
__pycache__/
*.pyc
*.pyo

# Each machine's own settings -- mic, buttons, beep volumes, window positions.
# A missing file is rebuilt from the Config model's defaults at launch.
userdata/config.json

# Collected audio -- too big for git, stays on the machine that recorded it
userdata/voice_recordings_PRIVATE/
*.flac

# Secrets
.env
